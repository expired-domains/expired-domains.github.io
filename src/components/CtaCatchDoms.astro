---
import { SITE } from '../config.js';

// End of sample. A line on paper, not a dark slab: the slab duplicated the
// header button, which put two primary calls to action on every page. The
// header button stays the primary one; this is the contextual link.
const {
  text = 'Want the full list of expired domains with complete SEO metrics?',
  label = 'See the full inventory on CatchDoms',
  href = SITE.catchdoms,
  count = null,
  shown = null,
} = Astro.props;
---
<aside class="cta-banner">
  <p>{count && shown
    ? <Fragment>Showing {shown} of <b>{count}</b> tracked domains.</Fragment>
    : text}</p>
  <a href={href} rel="sponsored noopener" target="_blank">{label} &rarr;</a>
</aside>
