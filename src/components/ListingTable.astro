---
import { ccFlag } from '../config.js';
const { domains = [], caption = 'Sample of tracked expired domains with their SEO metrics' } = Astro.props;

// An empty cell is a normal state: a small share of rows carry no Trust Flow
// at all. It renders as a quiet dash, never as a zero, because a zero sorts
// and compares while an absence does not.
const fmt = (n) => (n == null ? null : Number(n).toLocaleString('en-US'));
// Prices used to render as `$180000`. Grouped, they are readable at a glance.
const price = (n) => (n == null ? null : '$' + Number(n).toLocaleString('en-US'));
// The extension is dimmed so the eye lands on the name itself.
const split = (name) => {
  const i = String(name).indexOf('.');
  return i === -1 ? [name, ''] : [String(name).slice(0, i), String(name).slice(i)];
};
---
<div class="table-wrap" tabindex="0" role="region" aria-label="Expired domain listings">
  <table class="listing-table">
    <caption class="sr-only">{caption}. The table scrolls horizontally on narrow screens.</caption>
    <thead>
      <tr>
        <th>Domain</th>
        <th title="Quality score (0-100)">Score</th>
        <th title="Domain Authority">DA</th>
        <th title="Trust Flow">TF</th>
        <th title="Citation Flow">CF</th>
        <th title="Referring domains">Ref. dom.</th>
        <th title="Backlinks">Backlinks</th>
        <th>Age</th>
        <th>Price</th>
      </tr>
    </thead>
    <tbody>
      {domains.map((d) => {
        const flag = ccFlag(d.name);
        const [sld, ext] = split(d.name);
        return (
          <tr>
            <td class="dom">{sld}<span class="ext">{ext}</span>{flag && <span class="flag"> {flag}</span>}</td>
            <td class="sc">{d.score ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
            <td>{d.da ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
            <td>{d.tf ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
            <td>{d.cf ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
            <td>{fmt(d.rd) ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
            <td>{fmt(d.backlinks) ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
            <td>{d.age ? `${d.age}y` : <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
            <td class="price">{price(d.price) ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
