---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingTable from '../../components/ListingTable.astro';
import CtaCatchDoms from '../../components/CtaCatchDoms.astro';
import { SITE } from '../../config.js';
import listings from '../../data/listings.json';

export function getStaticPaths() {
  // One static page per TLD that has enough domains to avoid thin content.
  return Object.values(listings.tlds)
    .filter((t) => t.domains.length >= 1)
    .map((t) => ({ params: { tld: t.tld }, props: { data: t } }));
}

const { data } = Astro.props;
const { tld, label, total, avgDa, priceFrom, domains } = data;

const breadcrumb = [
  { name: 'Expired Domains', href: '/' },
  { name: 'TLDs', href: '/tlds/' },
  { name: label, href: `/tlds/${tld}/` },
];

const siblings = Object.values(listings.tlds).filter((t) => t.tld !== tld);
const topDa = Math.max(0, ...domains.map((d) => d.da ?? 0));
const topName = domains.slice().sort((a, b) => (b.score ?? 0) - (a.score ?? 0))[0]?.name;
const shown = domains.length;
const totalNum = Number(total) || 0;
const more = Math.max(0, totalNum - shown);
// Deep-link the CTA to the matching TLD page on CatchDoms (not the home) so the
// visitor lands on the same extension's full list. UTM-tagged for attribution.
const catchdomsTld = `${SITE.catchdoms}/tlds/${tld}?utm_source=expired-domains&utm_medium=satellite&utm_campaign=tld-listing`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${label} expired domains`,
    numberOfItems: shown,
    itemListElement: domains.map((d, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: d.name,
    })),
  },
];
---
<BaseLayout
  title={`${label} Expired Domains — Buy Dropped ${label} Domains`}
  description={`Browse ${totalNum.toLocaleString('en-US')}+ expired ${label} domains with traffic, backlinks and authority. Average DA ${avgDa}, prices from $${priceFrom}.`}
  breadcrumb={breadcrumb}
  schema={schema}
>
  <section class="hero">
    <h1>{label} expired domains</h1>
    <p class="lead">
      {totalNum.toLocaleString('en-US')} expired and dropping <strong>{label}</strong> domains,
      with an average domain authority of {avgDa} and prices starting at ${priceFrom}.
      Below are {shown} of the highest-scoring picks.
    </p>
  </section>

  <ListingTable domains={domains} />

  <CtaCatchDoms
    text={`Find ${more.toLocaleString('en-US')} more ${label} expired websites here`}
    label="Browse on CatchDoms"
    href={catchdomsTld}
  />

  <section class="section prose">
    <h2>About expired {label} domains</h2>
    <p>
      Expired {label} domains are {label} names whose previous owners let them lapse. Once they drop,
      they become available to register or buy again — often keeping the backlinks, age and authority
      they accumulated. For SEO, that means a head start: instead of building a {label} site from scratch,
      you inherit an existing footprint.
    </p>
    <p>
      Across the {totalNum.toLocaleString('en-US')} expired {label} domains we track, the average domain
      authority sits around {avgDa}, with the strongest names in this batch reaching DA {topDa}
      {topName ? ` (${topName})` : ''}. Prices start from ${priceFrom}, so there is room for both bargain
      registrations and higher-authority pickups.
    </p>
    <p>
      Before buying any {label} domain, run it through our <a href="/tools/whois-lookup/">WHOIS lookup</a>
      to confirm its dates and registrar, check its <a href="/tools/domain-age-checker/">age</a>, and review
      its DNS with our <a href="/tools/dns-lookup/">DNS lookup</a>. New to this? Read
      <a href="/guides/how-to-buy-expired-domains/"> how to buy expired domains</a> and
      <a href="/guides/expired-domains-for-seo/"> how to use expired domains for SEO</a>.
    </p>
  </section>

  <section class="section">
    <h2>Other extensions</h2>
    <div class="grid grid-3">
      {siblings.map((t) => (
        <a class="card" href={`/tlds/${t.tld}/`}>
          <h3>{t.label} expired domains</h3>
          <p class="muted">{Number(t.total).toLocaleString('en-US')} domains · avg DA {t.avgDa}</p>
        </a>
      ))}
    </div>
    <p style="margin-top:1rem"><a href="/tlds/">← Browse all expired domains by TLD</a></p>
  </section>
</BaseLayout>
