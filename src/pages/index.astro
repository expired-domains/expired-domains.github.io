---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingTable from '../components/ListingTable.astro';
import CtaCatchDoms from '../components/CtaCatchDoms.astro';
import { SITE, builtTools } from '../config.js';
import listings from '../data/listings.json';

const tlds = Object.values(listings.tlds);
const tools = builtTools();

// Teaser table for the home: top domains across all extensions by score.
const teaser = tlds
  .flatMap((t) => t.domains.map((d) => ({ ...d, tld: t.label })))
  .sort((a, b) => (b.score ?? 0) - (a.score ?? 0))
  .slice(0, 50);

const totalDomains = tlds.reduce((s, t) => s + (Number(t.total) || 0), 0);

const faqs = [
  {
    q: 'What is an expired domain?',
    a: 'An expired domain is a domain name whose previous owner did not renew it. Once it drops, it becomes available to register or buy again, often keeping the backlinks, traffic and authority it built up over the years.',
  },
  {
    q: 'Are expired domains good for SEO?',
    a: 'Expired domains can be powerful for SEO when they have a clean history, real referring domains and topical relevance. They give a new project a head start with existing authority instead of starting from zero.',
  },
  {
    q: 'How do you buy expired domains?',
    a: 'You can register a freshly dropped domain at any registrar, or bid on expiring names through auction platforms. Tools like CatchDoms aggregate expired and auction domains from many registrars with their SEO metrics so you can find the best ones.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Expired Domains — Find & Buy Expired Domains with Authority"
  description="Browse expired domains by extension, check WHOIS, DNS and domain age with free tools, and learn how to buy expired domains with traffic and backlinks for SEO."
  schema={schema}
>
  <section class="hero">
    <h1>Expired Domains</h1>
    <p class="lead">
      Find and buy <strong>expired domains</strong> with real traffic, backlinks and
      authority. Browse fresh drops by extension, check any domain with our free tools,
      and pick up names that already rank.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Top expired domains right now</h2>
      <a href="/tlds/">Browse all extensions →</a>
    </div>
    <p class="muted">
      A sample of the highest-scoring expired domains we are tracking. These are {teaser.length} of
      {totalDomains.toLocaleString('en-US')}+ — the full list with complete SEO metrics
      lives on <a href={SITE.catchdoms} rel="noopener" target="_blank">CatchDoms</a>.
    </p>
    <ListingTable domains={teaser} />

    <CtaCatchDoms
      text={`Tracking ${totalDomains.toLocaleString('en-US')}+ expired & auction domains across every extension.`}
      label="See them all on CatchDoms"
    />
  </section>

  <section class="section prose">
    <h2>Do expired domains still work for SEO?</h2>
    <p>
      Yes. An <strong>expired domain</strong> that kept clean, relevant backlinks still passes authority.
      SEOs use them two ways: rebuild a site on the domain to inherit its history, or 301-redirect it into
      an existing project to consolidate link equity. Because the domain already has age and trust, its
      pages tend to get indexed faster and rank sooner than a brand-new registration would.
    </p>

    <h2>How do expired domains work?</h2>
    <p>
      Every domain follows the same lifecycle. When the owner does not renew, it enters a grace period
      (around 30 days) during which they can still recover it, then a short redemption and pending-delete
      window. After that it drops and becomes available again — either at standard price through a registrar
      or via an expired domain auction. The names listed above sit at that stage: about to drop, or already
      biddable. If you are new to this, start with <a href="/guides/what-is-an-expired-domain/">what is an
      expired domain</a>.
    </p>

    <h2>Where can you buy expired domains?</h2>
    <p>
      There are three routes: register a fresh drop the moment it releases, bid in an auction before it
      drops, or place a backorder to catch a specific name automatically. We surface all three across
      <a href="/tlds/"> every extension</a>, and the full catalogue with complete SEO metrics lives on
      <a href={SITE.catchdoms} rel="noopener" target="_blank"> CatchDoms</a>. For the practical steps, read
      <a href="/guides/how-to-buy-expired-domains/"> how to buy expired domains</a>.
    </p>

    <h2>What metrics should you check before buying?</h2>
    <p>
      Authority is not created equal. Before buying, weigh Domain Authority (DA), Majestic Trust Flow and
      Citation Flow (TF / CF), referring domains (RD) and total backlinks — all shown in the table above —
      alongside the domain's age and its archive history. A high backlink count means little if the referring
      domains are spammy or off-topic. Vet any name in seconds with our free
      <a href="/tools/whois-lookup/">WHOIS lookup</a>, <a href="/tools/domain-age-checker/">domain age
      checker</a> and <a href="/tools/dns-lookup/">DNS lookup</a>.
    </p>

    <h2>How do SEOs find good expired domains?</h2>
    <p>
      By watching the drop. Thousands of domains expire every day; the good ones are found by scanning fresh
      lists and filtering hard on authority, topical relevance and a clean backlink profile. That is exactly
      what this site does — surfacing the highest-scoring expired domains by extension, refreshed daily. Learn
      the full playbook in <a href="/guides/expired-domains-for-seo/">expired domains for SEO</a>.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Browse expired domains by extension</h2>
      <a href="/tlds/">All TLDs →</a>
    </div>
    <div class="grid grid-3">
      {tlds.map((t) => (
        <a class="card" href={`/tlds/${t.tld}/`}>
          <h3>{t.label} expired domains</h3>
          <p class="muted">{Number(t.total).toLocaleString('en-US')} domains · avg DA {t.avgDa} · from ${t.priceFrom}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Free domain tools</h2>
      <a href="/tools/">All tools →</a>
    </div>
    <div class="grid grid-2">
      {tools.map((t) => (
        <a class="card" href={`/tools/${t.slug}/`}>
          <span class="tag">{t.category}</span>
          <h3>{t.name}</h3>
          <p class="muted">{t.short}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Frequently asked questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

</BaseLayout>
