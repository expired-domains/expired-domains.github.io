---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaCatchDoms from '../components/CtaCatchDoms.astro';
import listings from '../data/listings.json';
import { ccFlag } from '../config.js';

const tlds = Object.values(listings.tlds);

// Auctions only, and only ones that had not closed when this page was built.
// A static page cannot track a countdown: the honest thing is to publish the
// end date and say when the snapshot was taken, never "ends today".
const builtAt = new Date(listings.generatedAt + 'T00:00:00Z');
const rows = tlds
  .flatMap((t) => (t.domains || []).map((d) => ({ ...d, label: t.label })))
  .filter((d) => d.type === 'auction' && d.ends && new Date(d.ends) > builtAt)
  .sort((a, b) => new Date(a.ends) - new Date(b.ends))
  .slice(0, 40);

// Which marketplaces the auctions on this page actually came from. Derived,
// never written by hand: if a source stops appearing, this stops naming it.
const sources = [...new Set(rows.map((d) => d.source).filter(Boolean))];

const fmtDate = (iso) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const money = (n, c) =>
  n == null ? null : new Intl.NumberFormat('en-US', { style: 'currency', currency: c || 'USD', maximumFractionDigits: 0 }).format(n);

const breadcrumb = [
  { name: 'Expired Domains', href: '/' },
  { name: 'Expired Domain Auctions', href: '/expired-domain-auctions/' },
];

const faqs = [
  {
    q: 'What is an expired domain auction?',
    a: 'When a registrant lets a domain lapse, many registrars do not release it straight back to the public. They put it up for auction first, usually for seven to ten days, and the highest bidder takes it over at renewal. It is the stage between expiry and the domain actually dropping.',
  },
  {
    q: 'How is an auction different from a closeout?',
    a: 'An auction has competing bidders and a closing time, so the price moves. A closeout is a fixed price that falls on a schedule until someone buys it, with no bidding at all. The same registrar often runs both, which is why a listing type matters more than the platform it sits on.',
  },
  {
    q: 'Does a high bid mean the domain is good?',
    a: 'It means other buyers looked at the same history and decided to pay, which is a real signal and the reason bid count is worth reading alongside the metrics. It is not proof of a clean history. Several bidders on a small amount usually says more than one bidder on a large one.',
  },
  {
    q: 'Can I bid through this site?',
    a: 'No. Bidding happens on the platform that runs the auction, and each one has its own account and deposit rules. This page lists what is running so you can judge it, and links through to the listing itself.',
  },
  {
    q: 'What happens if nobody bids?',
    a: 'The domain usually moves on through the lifecycle: redemption, then pending delete, then it drops and becomes registrable again. That later stage is covered on the pending delete page.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Expired Domain Auctions: Live Listings With SEO Metrics"
  description="Expired domain auctions with their current bid, bid count and closing date, alongside Domain Authority, Trust Flow, referring domains and age. A daily snapshot across every extension tracked."
  breadcrumb={breadcrumb}
  schema={schema}
>
  <section class="hero">
    <div class="kicker">Snapshot · {listings.generatedAt}</div>
    <h1>Expired domain <em>auctions</em></h1>
    <p class="lead">
      When a domain expires, most registrars auction it before letting it drop. Here are
      auctions running at the time of this snapshot, with the bid, the bid count and the
      closing date next to the metrics that decide.
    </p>
  </section>

  {rows.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>Closing soonest</h2>
        <span class="source">{rows.length} auctions · snapshot {listings.generatedAt}</span>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Expired domain auctions closing soonest">
        <table class="listing-table">
          <caption class="sr-only">
            Expired domain auctions open at the time of the snapshot, soonest closing first.
            The table scrolls horizontally on narrow screens.
          </caption>
          <thead>
            <tr>
              <th>Domain</th><th>Closes</th><th>Bid</th><th>Bids</th>
              <th>Score</th><th>DA</th><th>TF</th><th>Ref. dom.</th><th>Age</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((d) => {
              const flag = ccFlag(d.name);
              const i = d.name.indexOf('.');
              return (
                <tr>
                  <td class="dom">{d.name.slice(0, i)}<span class="ext">{d.name.slice(i)}</span>{flag && <span class="flag"> {flag}</span>}</td>
                  <td>{fmtDate(d.ends)}</td>
                  <td class="price">{money(d.bid, d.currency) ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
                  <td>{d.bids ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
                  <td class="sc">{d.score ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
                  <td>{d.da ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
                  <td>{d.tf ?? <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
                  <td>{d.rd != null ? Number(d.rd).toLocaleString('en-US') : <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
                  <td>{d.age ? `${d.age}y` : <Fragment><span class="none" aria-hidden="true">&ndash;</span><span class="sr-only">Not available</span></Fragment>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <CtaCatchDoms
        text="This is a daily snapshot. Bids move, and auctions close between builds."
        label="See auctions live on CatchDoms"
      />
      {sources.length > 0 && (
        <p class="muted" style="margin-top:.4rem">
          The auctions above are running on {sources.join(', ')}. Bidding happens there, not here.
        </p>
      )}
    </section>
  )}

  <section class="section prose">
    <h2>Where an auction sits in the lifecycle</h2>
    <p>
      A domain does not go from expired to available overnight. It lapses, the registrar holds
      it through a grace period, and in most cases offers it at <strong>auction</strong> before
      anything else happens. If nobody takes it, it moves into redemption, then into a short
      pending delete window, and only then does it drop and become registrable by anyone.
    </p>
    <p>
      That matters for what you pay. At the auction stage you are bidding against other buyers,
      so a name with real history gets expensive. At the
      <a href="/pending-delete-domains/"> pending delete</a> stage nobody can bid any more, but
      catching the name takes a backorder and a bit of luck. The two stages suit different
      budgets and different appetites for certainty.
    </p>

    <h2>Reading an auction listing</h2>
    <p>
      The bid count is the part most people skip. A single bid on a large amount is one person's
      opinion. <strong>Several bidders on a modest amount is a market</strong>, and it usually
      means more than one researcher reached the same conclusion about the history. Read it
      together with referring domains and Trust Flow rather than instead of them.
    </p>
    <p>
      Treat a currency as part of the price. Auctions run on marketplaces in several countries
      and each quotes in its own currency, so a number without its symbol is not comparable.
    </p>
    <p>
      Before you bid, check what the domain actually was. Our
      <a href="/tools/whois-lookup/">WHOIS lookup</a> gives you the registrar and the dates, the
      <a href="/tools/domain-age-checker/">domain age checker</a> tells you how long it has
      existed, and <a href="/guides/expired-domains-for-seo/">how to judge an expired domain</a>
      covers the history checks that a metric cannot do for you.
    </p>

    <h2>Why this page is a snapshot and not a live feed</h2>
    <p>
      This site is static, rebuilt from a daily pull. Bids move continuously and auctions close
      on their own schedule, so by the time you read a row the bid is probably higher and the
      auction may be over. Rows that had already closed when the page was built are left out,
      but nothing here can be fresher than the snapshot date in the heading. For live state, go
      to the platform running the auction, or query the
      <a href="/expired-domains-api/">expired domains API</a>.
    </p>
  </section>

  <section class="section faq">
    <h2>Questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
</BaseLayout>
